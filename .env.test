# Used only by `npm test` (loaded by vitest.config.ts). Points at a
# separate database/schema so automated tests never touch dev data —
# docs/testing.md. Values are local-only Docker Compose defaults, not
# real secrets, so unlike .env this file is safe to commit.

NODE_ENV=test
DATABASE_URL=postgresql://jarvis:jarvis_dev_password@localhost:5442/jarvis_test?schema=public
REDIS_URL=redis://localhost:6389
AI_PROVIDER=mock
