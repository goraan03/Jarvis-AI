# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
# 4100/5442/6389 (not 4000/5432/6379) to avoid colliding with other local
# Docker projects' default ports.
PORT=4100

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://jarvis:jarvis_dev_password@localhost:5442/jarvis?schema=public

# Redis
REDIS_URL=redis://localhost:6389

# Session cookie signing — generate with: openssl rand -base64 32
SESSION_SECRET=

# Credential encryption at rest — generate with: openssl rand -base64 32
# Treat like a password. Back it up separately from the database. Losing it
# makes stored integration credentials unrecoverable, not just locked.
ENCRYPTION_MASTER_KEY=

# Owner bootstrap (used once by `npm run bootstrap:owner`, then remove)
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# AI provider: "mock" (default, no real model calls/cost) or "anthropic"
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Web search (Phase 3, optional until configured)
BRAVE_SEARCH_API_KEY=

# Telegram (Phase 4, optional until configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Google OAuth (Phase 5+, optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

# Browser automation (Phase 8, optional). Set to "true" only once you are
# also running apps/browser-worker — otherwise browse_page/fill_form/
# download_file are simply not registered (never a tool that just hangs).
BROWSER_WORKER_ENABLED=
