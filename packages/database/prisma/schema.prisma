generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Phase 1-2: owner identity, sessions, chat ---------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  conversations     Conversation[]
  settings          AgentSettings?
  usageRecords      UsageRecord[]
  tasks             Task[]
  integrations      Integration[]
  telegramLinkCodes TelegramLinkCode[]
  approvalRequests  ApprovalRequest[]
  oauthStates       OAuthState[]
  memories          Memory[]
  scheduledTasks    ScheduledTask[]
  researchReports   ResearchReport[]
  auditLogs         AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ipHash    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Channel {
  WEB
  TELEGRAM
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  channel   Channel   @default(WEB)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  tasks     Task[]

  @@index([userId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  providerUsed   String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model UsageRecord {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId        String?
  taskId                String?
  task                  Task?    @relation(fields: [taskId], references: [id])
  provider              String // 'anthropic' | 'mock'
  model                 String
  inputTokens           Int
  outputTokens          Int
  estimatedCostMicroUsd Int
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
}

model AgentSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultModel           String   @default("claude-sonnet-5")
  maxToolCallsPerTask    Int      @default(25)
  maxModelCallsPerTask   Int      @default(15)
  maxTaskDurationMs      Int      @default(300000)
  maxTokensPerTask       Int      @default(200000)
  maxCostMicroUsdPerTask Int      @default(500000)
  maxConcurrentTasks     Int      @default(2)
  maxRetriesPerToolCall  Int      @default(2)
  autoMemoryEnabled      Boolean  @default(true)
  approvalExceptions     Json?
  updatedAt              DateTime @updatedAt
}

// --- Phase 3: agent engine ------------------------------------------------

enum TaskStatus {
  PENDING
  PLANNING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  goal           String
  status         TaskStatus    @default(PENDING)
  planSummary    String?
  resultSummary  String?
  failureReason  String?
  limits         Json
  // In-progress message history + any tool calls from the current turn
  // not yet executed (because one of them is awaiting approval) — lets
  // the engine pause and resume exactly where it left off instead of
  // needing to replay/reconstruct state from TaskStep rows.
  conversationState Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  steps            TaskStep[]
  toolExecutions   ToolExecution[]
  usageRecords     UsageRecord[]
  approvalRequests ApprovalRequest[]
  researchReports  ResearchReport[]

  @@index([userId, status])
}

enum StepKind {
  MODEL_TURN
  TOOL_CALL_REQUESTED
  APPROVAL_REQUESTED
  RETRY
  LIMIT_EXCEEDED
}

model TaskStep {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepIndex Int
  kind      StepKind
  detail    Json
  createdAt DateTime @default(now())

  @@index([taskId, stepIndex])
}

enum ToolExecStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED_PERMISSION
  BLOCKED_APPROVAL
}

model ToolExecution {
  id           String         @id @default(cuid())
  taskId       String
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  toolName     String
  input        Json
  output       Json?
  status       ToolExecStatus @default(PENDING)
  errorMessage String?
  durationMs   Int?
  riskLevel    String
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  @@index([taskId])
  @@index([toolName])
}

// --- Phase 7: research reports ----------------------------------------------

// `sources` is a Json array of {toolExecutionId, note}. Each toolExecutionId
// is verified (exists, belongs to this report's taskId) by
// generate_research_report before the report is created — never trusted
// from model output alone. See docs/security-model.md §6 (tool output is
// data, not an authority) applied to citations: a citation is only as
// trustworthy as the real row it points to.
model ResearchReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  summary   String
  sources   Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskId])
}

// --- Phase 9: audit log -----------------------------------------------------

// action is a dotted verb like 'auth.login', 'approval.approve',
// 'integration.disconnect', 'tool.execute' — not an enum, so new actions
// never require a migration. metadata is redacted (packages/security
// redactObject) before insert, never raw request/response bodies — see
// docs/security-model.md §10.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// --- Phase 4: Telegram -----------------------------------------------------

model Integration {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String // 'telegram' (more added in later phases)
  status     String // 'connected' | 'disconnected'
  externalId String? // e.g. Telegram chat id, as a string
  metadata   Json? // non-secret details only — never tokens
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  credential EncryptedCredential?

  @@unique([userId, provider])
}

/** OAuth tokens, encrypted at rest (AES-256-GCM, packages/security) —
 * docs/security-model.md §4. Only a refresh_token is ever stored; access
 * tokens are short-lived and re-fetched on demand, never persisted. */
model EncryptedCredential {
  id            String      @id @default(cuid())
  integrationId String      @unique
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  ciphertext    Bytes
  iv            Bytes
  authTag       Bytes
  keyVersion    Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

/** Short-lived, single-use CSRF state for an OAuth authorization-code
 * flow — validated and deleted on the callback, docs/security-model.md §9. */
model OAuthState {
  state     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/** One-time code the owner sends to the bot to prove they control a given
 * Telegram chat — never a secret stored long-term, single-use, short TTL. */
model TelegramLinkCode {
  code      String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/** Idempotency ledger: every Telegram update_id we've started processing,
 * so a redelivered update (webhook retry, restarted poll loop) can never
 * cause a duplicate task or duplicate message — docs/security-model.md §9. */
model TelegramUpdate {
  updateId  BigInt   @id
  createdAt DateTime @default(now())
}

// --- Phase 5: approvals + Google integrations -------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

/** Authorizes exactly one tool call with exactly these parameters — never
 * "the model said it's fine." boundInput/inputHash are re-checked at
 * execution time, not just at decision time — docs/security-model.md §5. */
model ApprovalRequest {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId       String
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  toolName     String
  boundInput   Json
  inputHash    String
  status       ApprovalStatus @default(PENDING)
  requestedVia Channel
  decidedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime       @default(now())

  @@index([userId, status])
  @@index([taskId])
}

// --- Phase 6: memory + scheduler -------------------------------------------

enum MemoryStatus {
  PROPOSED
  APPROVED
  REJECTED
  ARCHIVED
}

/** search is done via a generated tsvector column + GIN index added by
 * raw SQL in this model's migration (Prisma can't express generated
 * columns) — see docs/database-design.md "Memory". */
model Memory {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String // 'fact' | 'preference' | 'project' | ...
  content    String
  source     String // 'conversation' | 'task' | 'manual'
  confidence Float        @default(1.0)
  status     MemoryStatus @default(PROPOSED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Generated column added by raw SQL (20261022150740_memory_fts).
  // Unsupported tells Prisma to leave its type/management alone so
  // `migrate dev` never tries to "fix" drift by dropping it.
  searchVector Unsupported("tsvector")?

  @@index([userId, status])
}

/** One-time (runAt) or recurring (cronExpression) task the scheduler
 * fires by creating a real agent Task — docs/implementation-roadmap.md
 * Phase 6. bullSchedulerId is the deterministic id used with BullMQ's
 * upsertJobScheduler/removeJobScheduler so re-registering on worker boot
 * is idempotent rather than additive. */
model ScheduledTask {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  cronExpression String?
  runAt          DateTime?
  timezone       String
  payload        Json
  status         String // 'active' | 'paused' | 'cancelled'
  bullSchedulerId String?
  lastRunAt      DateTime?
  lastStatus     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  runs ScheduledTaskRun[]

  @@index([userId, status])
}

/** Idempotency ledger for scheduled firings: a unique key per (schedule,
 * time window) means a redelivered/duplicate trigger within the same
 * window is a guaranteed no-op — mirrors TelegramUpdate's pattern. */
model ScheduledTaskRun {
  id              String        @id @default(cuid())
  scheduledTaskId String
  scheduledTask   ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)
  idempotencyKey  String        @unique
  taskId          String?
  status          String // 'created' | 'skipped_concurrency_limit' | 'failed'
  createdAt       DateTime      @default(now())

  @@index([scheduledTaskId])
}
