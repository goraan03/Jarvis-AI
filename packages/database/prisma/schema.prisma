generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Phase 1-2: owner identity, sessions, chat ---------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  conversations Conversation[]
  settings      AgentSettings?
  usageRecords  UsageRecord[]
  tasks         Task[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ipHash    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Channel {
  WEB
  TELEGRAM
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  channel   Channel   @default(WEB)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  tasks     Task[]

  @@index([userId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  providerUsed   String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model UsageRecord {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId        String?
  taskId                String?
  task                  Task?    @relation(fields: [taskId], references: [id])
  provider              String // 'anthropic' | 'mock'
  model                 String
  inputTokens           Int
  outputTokens          Int
  estimatedCostMicroUsd Int
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
}

model AgentSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultModel           String   @default("claude-sonnet-5")
  maxToolCallsPerTask    Int      @default(25)
  maxModelCallsPerTask   Int      @default(15)
  maxTaskDurationMs      Int      @default(300000)
  maxTokensPerTask       Int      @default(200000)
  maxCostMicroUsdPerTask Int      @default(500000)
  maxConcurrentTasks     Int      @default(2)
  maxRetriesPerToolCall  Int      @default(2)
  autoMemoryEnabled      Boolean  @default(true)
  approvalExceptions     Json?
  updatedAt              DateTime @updatedAt
}

// --- Phase 3: agent engine ------------------------------------------------

enum TaskStatus {
  PENDING
  PLANNING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  goal           String
  status         TaskStatus    @default(PENDING)
  planSummary    String?
  resultSummary  String?
  failureReason  String?
  limits         Json
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  steps          TaskStep[]
  toolExecutions ToolExecution[]
  usageRecords   UsageRecord[]

  @@index([userId, status])
}

enum StepKind {
  MODEL_TURN
  TOOL_CALL_REQUESTED
  APPROVAL_REQUESTED
  RETRY
  LIMIT_EXCEEDED
}

model TaskStep {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepIndex Int
  kind      StepKind
  detail    Json
  createdAt DateTime @default(now())

  @@index([taskId, stepIndex])
}

enum ToolExecStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED_PERMISSION
  BLOCKED_APPROVAL
}

model ToolExecution {
  id           String         @id @default(cuid())
  taskId       String
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  toolName     String
  input        Json
  output       Json?
  status       ToolExecStatus @default(PENDING)
  errorMessage String?
  durationMs   Int?
  riskLevel    String
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  @@index([taskId])
  @@index([toolName])
}
